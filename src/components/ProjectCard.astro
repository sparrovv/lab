---
interface Props {
  title: string;
  description: string;
  href: string;
  tags?: string[];
}

const { title, description, href, tags = [] } = Astro.props;
---

<a class="project-card" href={href}>
  <span class="project-card__kicker">Project</span>
  <h2>{title}</h2>
  <p>{description}</p>
  {
    tags.length > 0 && (
      <ul aria-label={`${title} tags`}>
        {tags.map((tag) => (
          <li>{tag}</li>
        ))}
      </ul>
    )
  }
</a>

<style>
  .project-card {
    display: flex;
    min-height: 236px;
    flex-direction: column;
    gap: 14px;
    padding: 22px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--panel);
    text-decoration: none;
    transition:
      border-color 160ms ease,
      transform 160ms ease,
      box-shadow 160ms ease;
  }

  .project-card:hover {
    border-color: rgba(33, 104, 105, 0.5);
    box-shadow: 0 16px 40px rgba(23, 32, 38, 0.08);
    transform: translateY(-2px);
  }

  .project-card__kicker {
    color: var(--accent);
    font-size: 0.78rem;
    font-weight: 760;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  h2 {
    margin: 0;
    font-size: clamp(1.35rem, 2vw, 1.75rem);
    line-height: 1.15;
  }

  p {
    margin: 0;
    color: var(--muted);
    line-height: 1.58;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding: 0;
    margin: auto 0 0;
    list-style: none;
  }

  li {
    padding: 6px 9px;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--muted);
    font-size: 0.8rem;
  }
</style>
