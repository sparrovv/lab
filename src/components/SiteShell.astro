---
interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Independent experiments, lessons, analyses, and tools.' } = Astro.props;
const baseUrl = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <style>
      :root {
        color-scheme: light;
        --ink: #172026;
        --muted: #58656f;
        --line: #d9e0e6;
        --paper: #fbfcfd;
        --panel: #ffffff;
        --accent: #216869;
        --accent-strong: #174c4d;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        font-family:
          Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
          sans-serif;
        color: var(--ink);
        background: var(--paper);
      }

      a {
        color: inherit;
      }

      .shell {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }

      .site-header {
        border-bottom: 1px solid var(--line);
        background: rgba(251, 252, 253, 0.92);
        backdrop-filter: blur(14px);
      }

      .site-header__inner,
      .site-main,
      .site-footer__inner {
        width: min(1120px, calc(100% - 32px));
        margin: 0 auto;
      }

      .site-header__inner {
        min-height: 64px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
      }

      .brand {
        font-weight: 760;
        text-decoration: none;
      }

      .site-nav {
        display: flex;
        gap: 18px;
        color: var(--muted);
        font-size: 0.95rem;
      }

      .site-nav a {
        text-decoration: none;
      }

      .site-nav a:hover {
        color: var(--accent-strong);
      }

      .site-main {
        flex: 1;
      }

      .site-footer {
        margin-top: 64px;
        border-top: 1px solid var(--line);
      }

      .site-footer__inner {
        padding: 24px 0;
        color: var(--muted);
        font-size: 0.92rem;
      }
    </style>
  </head>
  <body>
    <div class="shell">
      <header class="site-header">
        <div class="site-header__inner">
          <a class="brand" href={baseUrl}>Lab</a>
          <nav class="site-nav" aria-label="Main navigation">
            <a href={baseUrl}>Projects</a>
          </nav>
        </div>
      </header>
      <main class="site-main">
        <slot />
      </main>
      <footer class="site-footer">
        <div class="site-footer__inner">Static-first AI-assisted lab. Each project is isolated.</div>
      </footer>
    </div>
  </body>
</html>
